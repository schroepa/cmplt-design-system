        "lineHeight": "1.28",
        "tracking": "-0.015em",
        "weight": "600 (Dark: 585)",
        "measure": "28ch",
        "wrap": "balance",
        "usage": "Sub-section & feature card headings (H3)"
      },
      "heading-sm": {
        "step": "Step 1 (H4)",
        "cssVar": "--type-step-1",
        "tailwindClass": "text-heading-sm",
        "roleClass": "cmplt-h4",
        "minPx": 17,
        "maxPx": 20,
        "clamp": "clamp(1.0625rem, 0.9943rem + 0.2778vw, 1.25rem)",
        "lineHeight": "1.28",
        "tracking": "-0.015em",
        "weight": "500 (Dark: 485)",
        "measure": "42ch",
        "wrap": "balance",
        "usage": "Group titles & panel headers (H4)"
      },
      "lead": {
