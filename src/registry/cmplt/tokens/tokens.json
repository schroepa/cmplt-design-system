  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "0.375rem",
      "cssVar": "--radius-xs",
      "px": "6px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.5rem",
      "cssVar": "--radius-sm",
      "px": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.625rem",
      "cssVar": "--radius-md",
      "px": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1.25rem",
      "cssVar": "--radius-lg",
      "px": "20px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1.5rem",
      "cssVar": "--radius-xl",
      "px": "24px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "cssVar": "--radius-full",
      "px": "9999px"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Geist Variable",
        "cssVar": "--font-geist-sans",
        "tailwindClass": "font-sans",
        "weights": "100\u2013900 (Variable wght axis)",
        "darkOpticalOffset": "-15 to -20 wght (Anti-Halation)"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "Geist Mono Variable",
        "cssVar": "--font-geist-mono",
        "tailwindClass": "font-mono",
        "weights": "100\u2013900 (Variable wght axis)",
        "features": "tabular-nums, zero, calt"
      }
    },
    "scaleEngine": {
      "strategy": "Dual-Scale Liquid Utopia (clamp) + Static UI Separation",
      "viewportMin": "360px",
      "viewportMax": "1440px",
      "ratioMin": "1.200 (Minor Third)",
      "ratioMax": "1.333 (Perfect Fourth)"
    },
    "liquidScale": {
      "display-xl": {
        "step": "Step 6",
        "cssVar": "--type-step-6",
        "tailwindClass": "text-display-xl",
        "roleClass": "cmplt-display-xl",
        "minPx": 42,
        "maxPx": 76,
        "clamp": "clamp(2.625rem, 1.8523rem + 3.1481vw, 4.75rem)",
        "lineHeight": "1.04",
        "tracking": "-0.035em",
        "weight": "600 (Dark: 585)",
        "measure": "18ch",
        "wrap": "balance",
        "usage": "Hero statements & oversized KPI display"
      },
      "display-lg": {
        "step": "Step 5",
        "cssVar": "--type-step-5",
        "tailwindClass": "text-display-lg",
        "roleClass": "cmplt-display-lg",
        "minPx": 36,
        "maxPx": 60,
        "clamp": "clamp(2.25rem, 1.7045rem + 2.2222vw, 3.75rem)",
        "lineHeight": "1.04",
        "tracking": "-0.035em",
        "weight": "600 (Dark: 585)",
        "measure": "18ch",
        "wrap": "balance",
        "usage": "Page display headers & feature callouts"
