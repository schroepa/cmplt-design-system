    "semantic": {
      "bg.canvas": {
        "$type": "color",
        "cssVar": "--bg-canvas",
        "tailwindClass": "bg-canvas",
        "light": "#eeeeec (oklch 0.950)",
        "dark": "#1f1f1e (oklch 0.242)",
        "$description": "Page canvas",
        "figmaScope": [
          "FRAME_FILL"
        ]
      },
      "bg.surface": {
        "$type": "color",
        "cssVar": "--bg-surface",
        "tailwindClass": "bg-surface",
        "light": "#fbfbf9 (oklch 0.985)",
        "dark": "#262625 (oklch 0.270)",
        "$description": "Primary card shell",
        "figmaScope": [
          "FRAME_FILL",
          "SHAPE_FILL"
        ]
      },
      "bg.elevated": {
        "$type": "color",
