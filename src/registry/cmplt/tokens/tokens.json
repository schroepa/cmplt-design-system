        "roleClass": "cmplt-lead",
        "minPx": 17,
        "maxPx": 20,
        "clamp": "clamp(1.0625rem, 0.9943rem + 0.2778vw, 1.25rem)",
        "lineHeight": "1.65",
        "tracking": "-0.005em",
        "weight": "400 (Dark: 380)",
        "measure": "54ch",
        "wrap": "pretty",
        "usage": "Editorial lead / deck paragraphs"
      },
      "body": {
        "step": "Step 0 (Base)",
        "cssVar": "--type-step-0",
        "tailwindClass": "text-body",
        "roleClass": "cmplt-body",
        "minPx": 15,
        "maxPx": 16,
        "clamp": "clamp(0.9375rem, 0.9148rem + 0.0926vw, 1rem)",
        "lineHeight": "1.65",
        "tracking": "-0.005em",
        "weight": "400 (Dark: 380)",
        "measure": "65ch",
        "wrap": "pretty",
        "usage": "Long-form prose & primary reading copy"
      }
    },
    "uiScale": {
      "ui-lg": {
        "cssVar": "--ui-lg",
        "tailwindClass": "text-ui-lg",
        "px": "15px",
        "rem": "0.9375rem",
        "usage": "Large CTA buttons & hero inputs"
      },
      "ui-md": {
        "cssVar": "--ui-md",
        "tailwindClass": "text-ui-md",
        "px": "14px",
        "rem": "0.875rem",
        "usage": "Navigation links, dialog copy, prominent controls"
      },
      "ui-sm": {
        "cssVar": "--ui-sm",
        "tailwindClass": "text-ui-sm",
        "px": "13px",
        "rem": "0.8125rem",
        "usage": "Default buttons, form inputs, dropdown menus, table cells"
      },
      "ui-xs": {
        "cssVar": "--ui-xs",
        "tailwindClass": "text-ui-xs",
        "px": "12px",
        "rem": "0.75rem",
        "usage": "Captions, field descriptions, uppercase section eyebrows"
      },
      "ui-2xs": {
        "cssVar": "--ui-2xs",
        "tailwindClass": "text-ui-2xs",
        "px": "11px",
        "rem": "0.6875rem",
        "usage": "Badges, Kbd shortcuts, status pills"
      }
    },
    "measures": {
      "display": {
        "cssVar": "--measure-display",
        "tailwindClass": "max-w-measure-display",
        "value": "18ch",
        "usage": "Hero headlines (2\u20134 words per line)"
      },
      "heading": {
        "cssVar": "--measure-heading",
        "tailwindClass": "max-w-measure-heading",
        "value": "28ch",
        "usage": "Section headings H1\u2013H3"
      },
      "compact": {
        "cssVar": "--measure-compact",
        "tailwindClass": "max-w-measure-compact",
        "value": "42ch",
        "usage": "Cards, modals, sidebars & callout boxes"
      },
      "lead": {
        "cssVar": "--measure-lead",
        "tailwindClass": "max-w-measure-lead",
        "value": "54ch",
        "usage": "Introductory lead paragraphs"
      },
      "body": {
        "cssVar": "--measure-body",
        "tailwindClass": "max-w-measure-body",
        "value": "65ch",
        "usage": "Bringhurst ideal 60\u201370ch long-form reading width"
      }
